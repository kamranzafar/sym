<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <!--
      Sym (Speak Your Mind): short messages over a REST API, stored in a document store, cached on request, and
      streamed to Kafka for other consumers. One jar runs on AWS, Azure and Google Cloud, or with no cloud at all;
      a Spring profile picks which. Halyx is the only cloud API the code uses.
    -->
    <groupId>org.kamranzafar</groupId>
    <artifactId>sym</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>sym</name>

    <properties>
        <java.version>21</java.version>
        <halyx.version>1.0.2</halyx.version>
        <!-- Security fixes over Boot 4.1.1's versions, as Halyx's own sample carries them -->
        <netty.version>4.2.19.Final</netty.version>
        <tomcat.version>11.0.27</tomcat.version>
        <logback.version>1.6.5</logback.version>
        <slf4j.version>2.0.19</slf4j.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-bom</artifactId>
                <version>${halyx.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>dev.halyx</groupId>
            <artifactId>halyx-spring-boot-starter</artifactId>
        </dependency>
        <!-- Every provider, so the same jar runs on each cloud -->
        <dependency>
            <groupId>dev.halyx</groupId>
            <artifactId>halyx-aws</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.halyx</groupId>
            <artifactId>halyx-azure</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.halyx</groupId>
            <artifactId>halyx-gcp</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.halyx</groupId>
            <artifactId>halyx-spring-data-document</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- the repackaged jar can't be put on a classpath; the tests use the classes -->
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
